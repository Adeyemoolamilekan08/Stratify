# Copy this to .env for local dev, and set the same keys in
# Vercel → Project → Settings → Environment Variables for Production/Preview.

# Your deployed Laravel API base URL (must be HTTPS, and CORS must allow your Vercel domain)
VITE_API_URL=https://api.yourdomain.com/api

# Your WebSocket URL (if using live-shopfloor / real-time features)
VITE_WS_URL=wss://api.yourdomain.com
